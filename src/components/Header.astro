---
const currentPath = Astro.url.pathname;
const navItems = [
  { href: '/', label: 'Startseite' },
  { href: '/sprueche/', label: 'Sprüche' },
  { href: '/lebenshilfe/', label: 'Lebenshilfe' },
  { href: '/ueber-mich/', label: 'Über mich' },
  { href: '/kontakt/', label: 'Kontakt' },
];
---

<header class="bg-cream border-b border-sand/50 sticky top-0 z-50">
  <nav class="max-w-4xl mx-auto px-4 py-4" aria-label="Hauptnavigation">
    <a href="/" class="block text-2xl font-serif font-semibold text-stone-dark hover:text-gold transition-colors mb-4">
      GlückskeksNinja
    </a>
    <ul class="flex flex-wrap gap-4 sm:gap-6 text-sm">
      {navItems.map((item) => (
        <li>
          <a
            href={item.href}
            class:list={[
              'font-medium transition-colors',
              currentPath === item.href || (item.href !== '/' && currentPath.startsWith(item.href))
                ? 'text-gold'
                : 'text-stone hover:text-gold'
            ]}
          >
            {item.label}
          </a>
        </li>
      ))}
    </ul>
  </nav>
</header>
