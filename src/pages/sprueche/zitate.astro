---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { site } from '../../data/site';

const itemListSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Zitate – GlückskeksNinja',
  description: 'Weisheiten und Zitate für Inspiration und persönliches Wachstum.',
  url: `${site.url}/sprueche/zitate/`,
};
---

<Layout
  title="Zitate | GlückskeksNinja"
  description="Weisheiten und Zitate für Inspiration. Die kleinen Impulse von außen, die innen große Dinge bewirken können."
  canonical="/sprueche/zitate/"
  schema={itemListSchema}
>
  <Header />
  <main id="content" class="max-w-4xl mx-auto px-4 py-12">
    <h1 class="text-4xl font-serif font-semibold text-stone-dark mb-8">Zitate</h1>
    <p class="text-stone leading-relaxed mb-12">
      Weisheiten von großen Denkern und Quellen der Inspiration. <a href="/sprueche/" class="text-gold hover:text-warm-brown font-medium">Zurück zu allen Sprüchen</a>.
    </p>
  </main>
  <Footer />
</Layout>
